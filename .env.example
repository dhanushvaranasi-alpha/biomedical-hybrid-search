# Copy to .env (never commit .env)

# One key for every LLM call (expansion, answers, judge). Get it at https://openrouter.ai/keys
# Tip: buy >= $10 credit; accounts with no credit are limited to 50 free-model requests/day.
OPENROUTER_API_KEY=sk-or-...

# LiteLLM model strings: "openrouter/" + the OpenRouter model ID.
# Confirm exact IDs at https://openrouter.ai/models before the first run
# (candidates seen on 2026-09-30, unverified: ~openai/gpt-luna-latest, google/gemini-3.8-flash-20260902).
# Prefer pinned, dated IDs over "-latest" aliases so evaluation runs stay reproducible.
LLM_EXPANDER_MODEL=openrouter/openai/<luna-model-id>
LLM_ANSWER_MODEL=openrouter/openai/<luna-model-id>
LLM_JUDGE_MODEL=openrouter/google/<gemini-3.8-flash-model-id>

# Optional (shown to OpenRouter)
OR_APP_NAME=biomedical-hybrid-search
