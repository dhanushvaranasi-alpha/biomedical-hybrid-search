# Copy to .env (never commit .env)

# One key for every LLM call (expansion, answers, judge). Get it at https://openrouter.ai/keys
# Tip: buy >= $10 credit; accounts with no credit are limited to 50 free-model requests/day.
OPENROUTER_API_KEY=sk-or-...

# LiteLLM model strings: "openrouter/" + the OpenRouter model ID.
# IDs verified against OpenRouter's model list on 2026-09-30 (prices per 1M tokens, in/out):
#   openai/gpt-6-luna       $0.10 / $0.50   expansion + answers
#   google/gemini-3.8-flash $0.75 / $3.75   fixed judge (different vendor from the answerer)
# Avoid "-latest" aliases so evaluation runs stay reproducible.
LLM_EXPANDER_MODEL=openrouter/openai/gpt-6-luna
LLM_ANSWER_MODEL=openrouter/openai/gpt-6-luna
LLM_JUDGE_MODEL=openrouter/google/gemini-3.8-flash

# Hard spending cap in USD, enforced in code and remembered across runs
LLM_BUDGET_USD=8.0

# Optional (shown to OpenRouter)
OR_APP_NAME=biomedical-hybrid-search
